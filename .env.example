# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dengue
DB_USER=postgres
DB_PASSWORD=

# Esquema y tabla
DB_SCHEMA=public
DB_TABLE=valle_mun

# Parámetros de análisis
ANIO_DEFAULT=2024
MUNICIPIO_DEFAULT=CALI

# Ruta de salida para mapas y exportaciones
RUTA_SALIDA=outputs

# Fuente restringida de microdatos. Solo se leen agregados anónimos.
DENGUE_SOURCE_DB_NAME=dengue
DENGUE_GRID_SIZE_DEGREES=0.01
DENGUE_MIN_CELL_CASES=5
