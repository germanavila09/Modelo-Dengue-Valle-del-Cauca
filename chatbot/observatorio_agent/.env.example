# =====================================================================
# Configuración del agente ADK del Observatorio GeoSalud
# Copia este archivo como ".env" en la misma carpeta y rellena la API key.
# El archivo .env real ESTÁ EN .gitignore — nunca lo subas al repo.
# =====================================================================

# --- Modelo (Google AI Studio / Gemini) ----------------------------------
# Indica a ADK que use Google AI Studio (no Vertex AI):
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Tu API key de Google AI Studio (https://aistudio.google.com/apikey).
# Pégala aquí, sin comillas, sin espacios.
GOOGLE_API_KEY=PEGA_AQUI_TU_API_KEY

# --- Modelo Gemini -------------------------------------------------------
# Cuotas Free Tier (https://ai.google.dev/gemini-api/docs/rate-limits):
#   gemini-2.5-flash-lite ->   1.000 RPD, 15 RPM   (recomendado para dev)
#   gemini-2.5-flash      ->      20 RPD,  5 RPM   (muy ajustado en free)
#   gemini-2.5-pro        ->      50 RPD,  5 RPM
# RPD = requests per day, RPM = requests per minute.
# Una sola pregunta puede consumir 2-4 requests (decision + tool call(s) + respuesta).
GEMINI_MODEL=gemini-2.5-flash-lite
